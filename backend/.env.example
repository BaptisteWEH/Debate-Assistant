# Luxia LLM API
LUXIA_API_KEY=your-luxia-key-here

# SMTP (Gmail) - for sending debate feedback by email
# Create an App Password at: https://myaccount.google.com/apppasswords
SMTP_EMAIL=youraddress@gmail.com
SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# AWS - DynamoDB session persistence + S3 file storage (optional, falls back to in-memory)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_SESSION_TOKEN=your-session-token-if-using-temporary-credentials
AWS_REGION=us-east-1
S3_BUCKET_NAME=debatecoach-your-name-2026
