[Unit]
Description=DebateCoach FastAPI backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/app/backend
Environment="PATH=/home/ubuntu/app/.venv/bin"
EnvironmentFile=/home/ubuntu/app/backend/.env
ExecStart=/home/ubuntu/app/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
